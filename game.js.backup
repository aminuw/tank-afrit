    PLAYER_SPEED: 200, PLAYER_REVERSE_SPEED: 100, PLAYER_ROTATION_SPEED: 180,
    PLAYER_MAX_HEALTH: 100, PLAYER_SIZE: 35, PLAYER_TURRET_LENGTH: 45,
    BULLET_SPEED: 500, BULLET_DAMAGE: 25, BULLET_SIZE: 6, FIRE_RATE: 300,
    DASH_SPEED: 800, DASH_DURATION: 150, DASH_COOLDOWN: 1500,
    ENEMY_SPEED: 90, ENEMY_ROTATION_SPEED: 120, ENEMY_HEALTH: 60, ENEMY_SIZE: 32,
    ENEMY_FIRE_RATE: 1800, ENEMY_DETECTION_RANGE: 450, ENEMY_BULLET_DAMAGE: 12,
    MAX_ENEMIES: 10, SPAWN_INTERVAL: 3500,
    PARTICLE_COUNT: 20, ENEMY_KILL_SCORE: 100, SURVIVAL_SCORE: 1,
    SCREEN_SHAKE_DECAY: 0.9, SLOWMO_DURATION: 300, COMBO_TIMEOUT: 2000,
    // XP System
    XP_PER_KILL: 50,
    XP_LEVELS: [100, 250, 500, 800, 1200, 1700, 2300, 3000, 4000, 5200],
    // Boss System
    BOSS_SIZE: 55,
    BOSS_HEALTH_BASE: 300,
    BOSS_HEALTH_PER_WAVE: 150,
    BOSS_SPEED: 70,
    BOSS_FIRE_RATE: 800,
    BOSS_DAMAGE: 20,
    BOSS_SCORE: 500,
    BOSS_XP: 200,
    // Map Themes
    CHRISTMAS_MODE: true, // 🎄 ÉDITION NOËL ACTIVÉE
};

